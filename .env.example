# ==========================================
# VIBE FINANCE - ENVIRONMENT CONFIGURATION
# ==========================================

# Google Gemini API Key (Optional: for live LLM synthesis, falls back to deterministic engine if unset)
GEMINI_API_KEY=

# Backend Host & Port Configuration
HOST=0.0.0.0
PORT=8000

# SQLite Database Location (defaults to backend/vibe_finance.db)
DATABASE_PATH=backend/vibe_finance.db

# Frontend API Target (Vite development server)
VITE_API_URL=http://localhost:8000
